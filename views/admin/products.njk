{% extends "admin/layout.njk" %}
{% block title %}Products | Admin{% endblock %}

{% block admin %}
<div class="head admin-head">
  <div>
    <p class="eyebrow">Admin</p>
    <h1 class="display">Products</h1>
  </div>
  <a class="btn btn-gold" href="/admin/products/new">New Product</a>
</div>

{% if products.length %}
  <table class="admin-table">
    <thead><tr><th scope="col">Name</th><th scope="col">Category</th><th scope="col">Price</th><th scope="col">State</th><th scope="col">Images</th></tr></thead>
    <tbody>
      {% for product in products %}
        <tr>
          <th scope="row"><a href="/admin/products/{{ product.id }}">{{ product.name }}</a><br><small class="mono">/shop/{{ product.slug }}</small></th>
          <td>{{ product.category_name or '—' }}</td>
          <td>{{ product.price_pence | money }}</td>
          <td>
            {% if product.is_placeholder %}<span class="badge-placeholder">Placeholder</span>{% endif %}
            {% if product.is_published %}<span class="status status-paid">Published</span>{% else %}<span class="status status-pending">Draft</span>{% endif %}
          </td>
          <td>{{ product.images.length }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <p>No products yet. <a href="/admin/products/new">Add the first one</a>.</p>
{% endif %}
{% endblock %}
