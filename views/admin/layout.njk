{% extends "layout.njk" %}

{% block head %}<meta name="robots" content="noindex,nofollow">{% endblock %}

{% block content %}
<section class="band band-line admin-bar">
  <div class="wrap">
    <nav class="admin-nav" aria-label="Admin">
      <a href="/admin"{% if currentPath == '/admin' %} aria-current="page"{% endif %}>Dashboard</a>
      <a href="/admin/products"{% if '/admin/products' in currentPath %} aria-current="page"{% endif %}>Products</a>
      <a href="/admin/categories"{% if '/admin/categories' in currentPath %} aria-current="page"{% endif %}>Categories</a>
      <a href="/admin/orders"{% if '/admin/orders' in currentPath %} aria-current="page"{% endif %}>Orders</a>
      <a href="/" class="admin-nav-out">View shop &rarr;</a>
    </nav>
  </div>
</section>

<section class="band">
  <div class="wrap">
    {% block admin %}{% endblock %}
  </div>
</section>
{% endblock %}
