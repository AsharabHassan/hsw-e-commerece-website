{% extends "layout.njk" %}
{% block title %}Sign In | {{ storeName }}{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}

{% block content %}
<section class="band">
  <div class="wrap">
    <div class="head centred">
      <p class="eyebrow">Account</p>
      <h1 class="display">Sign <span class="gold">In</span></h1>
    </div>

    <form method="post" action="/account/login" class="auth-form" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="next" value="{{ next }}">

      {% if errors._ %}<p class="flash flash-error">{{ errors._ }}</p>{% endif %}

      <div class="field{% if errors.email %} has-error{% endif %}">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" autocomplete="email" required value="{{ values.email }}">
        {% if errors.email %}<p class="field-error">{{ errors.email }}</p>{% endif %}
      </div>

      <div class="field{% if errors.password %} has-error{% endif %}">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
        {% if errors.password %}<p class="field-error">{{ errors.password }}</p>{% endif %}
      </div>

      <button class="btn btn-gold" type="submit">Sign In</button>

      <p class="auth-alt">No account? <a href="/account/register">Create one</a>. You do not need an account to place an order.</p>
    </form>
  </div>
</section>
{% endblock %}
