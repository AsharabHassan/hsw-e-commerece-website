{% extends "layout.njk" %}
{% block title %}Order {{ order.public_token | orderRef }} | {{ storeName }}{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}

{% block content %}
<section class="band">
  <div class="wrap">
    <div class="head centred">
      <p class="eyebrow">Order</p>
      <h1 class="display">{{ order.public_token | orderRef }}</h1>
    </div>
    <div class="narrow">
      {% include "partials/order-detail.njk" %}
      <p class="centred" style="margin-top:2.5rem"><a class="btn btn-line" href="/account">All your orders</a></p>
    </div>
  </div>
</section>
{% endblock %}
