{% extends "layout.njk" %}

{% block title %}Shop | {{ storeName }}{% endblock %}
{% block description %}Supplements formulated at our Harley Street clinic, with every milligram published in full.{% endblock %}

{% block content %}

<section class="band band-line">
  <div class="wrap">
    <div class="head centred">
      <p class="eyebrow">The Range</p>
      <h2 class="display">Everything We <span class="gold">Make</span></h2>
    </div>

  </div>
</section>

<section class="band">
  <div class="wrap">
    {% if products.length %}
      <div class="product-grid">
        {% for card in products %}{% include "partials/product-card.njk" %}{% endfor %}
      </div>
    {% else %}
      <p class="centred">Nothing is published in this category yet.</p>
    {% endif %}
  </div>
</section>

{% endblock %}
