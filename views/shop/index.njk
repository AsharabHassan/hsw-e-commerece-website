{% extends "layout.njk" %}

{% block title %}{% if category %}{{ category.name }}{% else %}Shop{% endif %} | {{ storeName }}{% endblock %}
{% block description %}{% if category and category.blurb %}{{ category.blurb }}{% else %}Supplements formulated at our Harley Street clinic.{% endif %}{% endblock %}

{% block content %}

<section class="band band-line">
  <div class="wrap">
    <div class="head centred">
      <p class="eyebrow">{{ 'Category' if category else 'The Range' }}</p>
      <h2 class="display">{% if category %}{{ category.name }}{% else %}Everything We <span class="gold">Make</span>{% endif %}</h2>
      {% if category and category.blurb %}<p class="sub">{{ category.blurb }}</p>{% endif %}
    </div>

    {% if categories.length %}
      <nav class="filter-row" aria-label="Filter by category">
        <a class="filter-chip{% if not category %} is-active{% endif %}" href="/shop">All</a>
        {% for cat in categories %}
          <a class="filter-chip{% if category and category.id == cat.id %} is-active{% endif %}"
             href="/shop?category={{ cat.slug }}">{{ cat.name }}</a>
        {% endfor %}
      </nav>
    {% endif %}
  </div>
</section>

<section class="band">
  <div class="wrap">
    {% if products.length %}
      <div class="product-grid">
        {% for card in products %}{% include "partials/product-card.njk" %}{% endfor %}
      </div>
    {% else %}
      <p class="centred">Nothing is published in this category yet.</p>
    {% endif %}
  </div>
</section>

{% endblock %}
