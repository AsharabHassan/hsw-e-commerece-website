# ---------------------------------------------------------------------------
# Harley Street Wellness store — environment
#
# Copy to .env and fill in. Never commit .env.
# config.js validates all of this at boot and refuses to start on bad input.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the node process listens on. nginx proxies to this.
PORT=3000

# Public origin, no trailing slash. Used for canonical URLs, Open Graph tags,
# the sitemap, and the Stripe success/cancel redirects.
BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION.
# Leave unset in development and the app uses PGlite (embedded Postgres, no
# server to install) persisted to .data/pglite.
#
# DATABASE_URL=postgres://hsw:PASSWORD@127.0.0.1:5432/hsw

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. At least 16 characters.
# Generate with:  openssl rand -hex 32
# Changing this logs every customer out.
#
# SESSION_SECRET=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# All optional. With no secret key, checkout shows a clear "payments are not
# configured" page instead of failing at the card form.
#
# Test keys start sk_test_ / pk_test_. Live keys start sk_live_ / pk_live_.
# The webhook secret comes from the Stripe dashboard when you register the
# endpoint  BASE_URL/webhooks/stripe  for the event
# checkout.session.completed.
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Shop settings
# ---------------------------------------------------------------------------
# Flat UK shipping, in PENCE. 495 = £4.95.
SHIPPING_PENCE=495

# Order subtotal in PENCE at or above which shipping is free. 7500 = £75.00.
FREE_SHIPPING_OVER_PENCE=7500

STORE_NAME=Harley Street Wellness
STORE_EMAIL=hello@harleystreetwellness.co.uk

# ---------------------------------------------------------------------------
# Seeding (npm run seed) — only read by db/seed.js
# ---------------------------------------------------------------------------
# ADMIN_EMAIL=admin@harleystreetwellness.co.uk
# ADMIN_PASSWORD=

# Session cookies are marked `secure` in production so browsers send them only
# over HTTPS. Set this to false ONLY while running on a bare IP before TLS is
# configured — over plain HTTP a session cookie is readable by anyone on the
# network path. Remove it the moment certbot is done.
# SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# Cash on delivery
# ---------------------------------------------------------------------------
# Offer cash on delivery alongside card payment. Set to false to withdraw it
# immediately without a code change — existing unpaid cash orders are
# unaffected and can still be collected.
#
# NOTE: most UK couriers no longer collect cash on standard parcels. Confirm
# your courier actually offers it before advertising this.
COD_ENABLED=true

# Cash handling fee in PENCE, added to cash-on-delivery orders. 425 = £4.25.
# It must reflect a genuine cost of collecting cash rather than a penalty for
# not paying by card.
COD_FEE_PENCE=425
